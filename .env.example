# ─── Server ───────────────────────────────
PORT=3001

# ─── Auth (use long random strings) ───────
JWT_SECRET=change_me_to_a_long_random_string
ADMIN_JWT_SECRET=change_me_to_another_long_random_string

# ─── AI Health Assistant (optional) ───────
# Leave empty to run the AI assistant in mock mode
ANTHROPIC_API_KEY=

# ─── Payments — iyzico (optional) ─────────
# Leave empty to run payments in mock mode
IYZICO_API_KEY=
IYZICO_SECRET_KEY=
IYZICO_URI=https://sandbox-api.iyzipay.com

# ─── Insurance (optional) ─────────────────
# Leave empty to run insurance checks in mock mode
MEDULA_API_KEY=
PRIVATE_INSURANCE_API_KEY=
